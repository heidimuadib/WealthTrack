# API Configuration
# For physical devices, set your computer's local IP address
# For emulators/simulators, this will be auto-detected
API_URL=http://YOUR_LOCAL_IP:3000

# Example for physical device:
# API_URL=http://192.168.1.100:3000

# Leave empty to use automatic detection (emulator: 10.0.2.2, iOS simulator: localhost)
