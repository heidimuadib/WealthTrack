# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is gitignored — never commit it, and never put real
# passwords in this example.
#
# Generate an upload key with:
#
#     keytool -genkeypair -v -storetype PKCS12 \
#       -keystore your-upload-key.keystore \
#       -alias your-key-alias -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the keystore itself outside the repository. Losing it, or its passwords,
# means the app can never be updated under the same identity again.

# Absolute path to the keystore. Use forward slashes even on Windows:
# .properties treats a backslash as an escape character.
storeFile=C:/path/to/your-upload-key.keystore

# The alias passed to -alias when the key was generated.
keyAlias=your-key-alias

# Left blank here on purpose. Filled in only in keystore.properties.
storePassword=
keyPassword=
