# Normalise line endings so a Windows checkout does not rewrite every file the
# moment it is touched. Text is stored LF in the repo and checked out native.
* text=auto

# Scripts that must stay LF regardless of platform — CRLF breaks the shebang.
*.sh text eol=lf
gradlew text eol=lf

*.bat text eol=crlf

# Binary — never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jar binary
*.db binary
