# Copy this file to .env and fill in your own values.
# Never commit .env — it is gitignored.

# --- Database ---------------------------------------------------------------
# Two connections to the same Postgres, and they are not interchangeable. Both
# are required: schema.prisma names the first as `url` and the second as
# `directUrl`, so a missing DIRECT_URL fails every `prisma migrate` command.
#
# The runtime connection — every query the server serves goes through this one.
# Port 6543 is the transaction-mode pooler: it hands the connection back after
# each statement, which is what lets a small instance carry many concurrent
# requests. That same behaviour is why it cannot run migrations, which need one
# session held open across several statements.
#
# Append ?pgbouncer=true on a transaction-mode pooler. It turns off prepared
# statements, which the pooler cannot keep track of across a reused connection —
# without it, queries intermittently fail with "prepared statement already
# exists" under load.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# The migration connection, and nothing else — Prisma reads it only for
# `migrate` and `db push`, never for a query the app makes. Port 5432 is the
# session-mode pooler, which holds one session for the whole connection: that
# is what lets a migration take an advisory lock and hold it until the last
# statement lands.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Secret used to sign JWTs. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a session lasts before the app asks for the password again. There is
# no refresh flow, so this is the whole session: shortening it logs people out
# mid-month, lengthening it leaves a usable token on the device for longer.
JWT_EXPIRES_IN=7d

# Google OAuth *Web* client id — the audience every Google ID token is checked
# against. The app sends it too, so it is not a secret. Leave blank to disable
# Google sign-in; /auth/google then returns 503 and the button hides itself.
# The Android OAuth client needs no id here: Google matches it by package name
# and signing certificate. Register a SHA-1 for every keystore you ship with.
GOOGLE_WEB_CLIENT_ID=

PORT=3000

# --- Password reset email ---------------------------------------------------
# Resend API key. Leave blank and password reset stays inert: tokens are still
# issued and the endpoint still answers normally, but no mail is sent — which
# is indistinguishable from the outside, and has to be, because the endpoint
# must never reveal whether an address has an account.
# Create at https://resend.com → API Keys. This is a server secret: it belongs
# here and never in the mobile app.
RESEND_API_KEY=

# The From address on reset mail. Must be on a domain verified in Resend, or
# their shared onboarding@resend.dev while testing.
EMAIL_FROM=WealthTrack <no-reply@example.com>

# Where reset links point. The public HTTPS origin serving the reset page —
# the same host as the API. Without it no link can be built and no mail is
# sent. Never a LAN address: the link is opened from a mailbox, which could be
# anywhere.
PUBLIC_APP_URL=https://wealthtrack.duckdns.org

# Prints reset links to the console so the flow can be walked end to end before
# an email provider exists. Ignored unless NODE_ENV is not "production", so it
# cannot leak a live token on the deployed server even if it is left set.
# PASSWORD_RESET_DEBUG=true

# Leave unset (or "development") on a development machine. Set it to exactly
# "production" on the deployed server: it is what turns on HSTS and what turns
# OFF the request logger, which prints every request body — including the ones
# carrying credentials — to stdout. Anything other than "production" is treated
# as development, so a forgotten value fails towards the safe local behaviour
# rather than towards a silent HTTPS upgrade the LAN phone cannot follow.
# NODE_ENV=production
